{
  "$defs": {
    "AudioFormat": {
      "description": "How PCM bytes are laid out.",
      "properties": {
        "channels": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "format": {
          "default": "f32le",
          "enum": [
            "f32le",
            "s16le"
          ],
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate"
      ],
      "title": "AudioFormat",
      "type": "object"
    },
    "ConsentVerdict": {
      "additionalProperties": false,
      "description": "What a service returns about a record: the verdict and its reason, never the record itself.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "revoked",
                "not-yet-signed",
                "expired",
                "likeness-not-covered",
                "use-not-covered",
                "delivery-not-covered"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "ok"
      ],
      "title": "ConsentVerdict",
      "type": "object"
    },
    "DarkroomDepth": {
      "description": "The depth map darkroom derived from the plate's record (``POST /depth/{record_id}``).",
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_license": {
          "minLength": 1,
          "title": "Model License",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        }
      },
      "required": [
        "model",
        "model_license",
        "sha256"
      ],
      "title": "DarkroomDepth",
      "type": "object"
    },
    "DarkroomRender": {
      "description": "The argus-darkroom generation a plate came from: its record, and what was asked for.\n\nDarkroom keeps the full record (the guard's verdicts included); this is what a reader of the plate needs to\nfind it again and to judge it. ``plate.sha256`` is the record's image sha256: the plate is darkroom's bytes.",
      "properties": {
        "cfg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cfg"
        },
        "checkpoint": {
          "minLength": 1,
          "title": "Checkpoint",
          "type": "string"
        },
        "darkroom_version": {
          "default": "",
          "title": "Darkroom Version",
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/DarkroomDepth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enforcing_policy": {
          "minLength": 1,
          "title": "Enforcing Policy",
          "type": "string"
        },
        "guidance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guidance"
        },
        "negative_prompt": {
          "default": "",
          "maxLength": 4000,
          "title": "Negative Prompt",
          "type": "string"
        },
        "outcome": {
          "const": "passed",
          "default": "passed",
          "description": "only a released image becomes a plate",
          "title": "Outcome",
          "type": "string"
        },
        "prompt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sampler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampler"
        },
        "scheduler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduler"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        },
        "workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        }
      },
      "required": [
        "record_id",
        "enforcing_policy",
        "checkpoint",
        "seed",
        "prompt"
      ],
      "title": "DarkroomRender",
      "type": "object"
    },
    "DriverHealth": {
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "name",
        "available"
      ],
      "title": "DriverHealth",
      "type": "object"
    },
    "DriverInfo": {
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DriverInfo",
      "type": "object"
    },
    "FaceManifest": {
      "description": "``manifest.json`` in a face's directory.\n\n``model`` and ``framing`` are the face's head, which every screen can show. ``framings`` holds the same face at\nother framings (``waist``, ``full``), each a model of its own beside it; a screen asks for one with ``?framing=``.",
      "properties": {
        "blendshapes": {
          "items": {
            "type": "string"
          },
          "title": "Blendshapes",
          "type": "array"
        },
        "framing": {
          "$ref": "#/$defs/Framing"
        },
        "framings": {
          "additionalProperties": {
            "$ref": "#/$defs/FramedModel"
          },
          "propertyNames": {
            "enum": [
              "waist",
              "full"
            ]
          },
          "title": "Framings",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "mask_version": {
          "default": "1.5",
          "title": "Mask Version",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelFile"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "name",
        "model",
        "provenance"
      ],
      "title": "FaceManifest",
      "type": "object"
    },
    "FaceScene": {
      "description": "The backdrop a face shows by default (``GET /face/{id}/scene``): a scene name, or null for a plain one.",
      "properties": {
        "scene": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene"
        }
      },
      "title": "FaceScene",
      "type": "object"
    },
    "Frame": {
      "description": "One animation frame. ``t_ms`` is its time on the audio timeline.",
      "properties": {
        "head": {
          "$ref": "#/$defs/Head"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "type": {
          "const": "frame",
          "default": "frame",
          "title": "Type",
          "type": "string"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "title": "Weights",
          "type": "array"
        }
      },
      "required": [
        "seq",
        "t_ms",
        "weights"
      ],
      "title": "Frame",
      "type": "object"
    },
    "FramedModel": {
      "additionalProperties": false,
      "description": "Another framing of the same face: its own model (a rigged ``.glb`` from the same preset) and camera.",
      "properties": {
        "framing": {
          "$ref": "#/$defs/Framing"
        },
        "model": {
          "$ref": "#/$defs/ModelFile"
        }
      },
      "required": [
        "model",
        "framing"
      ],
      "title": "FramedModel",
      "type": "object"
    },
    "Framing": {
      "description": "Where the viewer's camera sits for this head. Metres; the head's origin is the model's.",
      "properties": {
        "distance": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "title": "Distance",
          "type": "number"
        },
        "fov": {
          "default": 30.0,
          "exclusiveMaximum": 120,
          "exclusiveMinimum": 1,
          "title": "Fov",
          "type": "number"
        },
        "height": {
          "default": 0.0,
          "title": "Height",
          "type": "number"
        }
      },
      "title": "Framing",
      "type": "object"
    },
    "Generator": {
      "additionalProperties": false,
      "description": "How a generated face was made: the model (and its sha256), the seed and the prompt.",
      "properties": {
        "model": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Sha256"
        },
        "prompt": {
          "default": "",
          "maxLength": 4000,
          "title": "Prompt",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "model"
      ],
      "title": "Generator",
      "type": "object"
    },
    "Head": {
      "description": "Head rotation, in degrees.",
      "properties": {
        "pitch": {
          "default": 0.0,
          "title": "Pitch",
          "type": "number"
        },
        "roll": {
          "default": 0.0,
          "title": "Roll",
          "type": "number"
        },
        "yaw": {
          "default": 0.0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "title": "Head",
      "type": "object"
    },
    "Health": {
      "properties": {
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Stable names for faces: alias -> the face id it stands for now",
          "title": "Aliases",
          "type": "object"
        },
        "driver": {
          "$ref": "#/$defs/DriverHealth"
        },
        "faces": {
          "title": "Faces",
          "type": "integer"
        },
        "fps": {
          "title": "Fps",
          "type": "integer"
        },
        "free_vram_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Vram Mb"
        },
        "live": {
          "description": "Faces with a source connected",
          "items": {
            "type": "string"
          },
          "title": "Live",
          "type": "array"
        },
        "read_only": {
          "title": "Read Only",
          "type": "boolean"
        },
        "screens": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Screen"
            },
            "type": "array"
          },
          "description": "Per face (or alias, by the name the viewers used), the viewers that have reported their state",
          "title": "Screens",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "driver",
        "fps",
        "read_only",
        "faces"
      ],
      "title": "Health",
      "type": "object"
    },
    "ModelFile": {
      "description": "A face's model, in its directory: its file name, sha256 and format.\n\n- ``gltf``: a glTF 2.0 binary (``.glb``), morph targets named for the ARKit shapes. The default, so a\n  manifest from before 1.2 reads as it did.\n- ``lam-splat``: a LAM Gaussian-splat head (``.zip``): one folder holding ``skin.glb`` (the FLAME mesh and\n  its ARKit shapes), ``offset.ply`` (the splats), ``animation.glb``, ``vertex_order.json`` and optionally\n  ``iris_occlusion.json``.",
      "properties": {
        "file": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(glb|zip)$",
          "title": "File",
          "type": "string"
        },
        "format": {
          "default": "gltf",
          "description": "gltf: a .glb; lam-splat: a LAM Gaussian-splat head, a .zip",
          "enum": [
            "gltf",
            "lam-splat"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "title": "ModelFile",
      "type": "object"
    },
    "PlateEffects": {
      "additionalProperties": false,
      "description": "How much each built-in effect moves the still, 0 (off) to 1. All are functions of the scene's time.\n\n- ``drift``: the camera drifts slowly across the plate; with a depth map, near things move more (parallax).\n- ``sway``: leaves and fronds move in a breeze, where ``sway_mask`` is light, or by depth without one.\n- ``dapple``: light through leaves drifts over the scene.\n- ``pulse``: lights breathe, where ``light_mask`` is light.\n- ``soft``: how far out of focus the plate is, so it sits behind the face.\n- ``exposure``: the plate's brightness, so it sits behind the face (below 1 darkens).",
      "properties": {
        "dapple": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dapple",
          "type": "number"
        },
        "drift": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drift",
          "type": "number"
        },
        "exposure": {
          "default": 0.8,
          "maximum": 2.0,
          "minimum": 0.1,
          "title": "Exposure",
          "type": "number"
        },
        "pulse": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Pulse",
          "type": "number"
        },
        "soft": {
          "default": 0.4,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Soft",
          "type": "number"
        },
        "sway": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sway",
          "type": "number"
        }
      },
      "title": "PlateEffects",
      "type": "object"
    },
    "PlateImage": {
      "additionalProperties": false,
      "description": "One image of a plate, in its directory: the file, its sha256, and its size in pixels.",
      "properties": {
        "file": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.png$",
          "title": "File",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 8192,
          "title": "Height",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 8192,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "sha256",
        "width",
        "height"
      ],
      "title": "PlateImage",
      "type": "object"
    },
    "PlateManifest": {
      "description": "``background.json`` in a plate's directory: a still image, animated by the viewer's built-in effects.\n\nThe plate is the picture; ``depth`` (near is light) gives parallax and places the sway; ``sway_mask`` and\n``light_mask`` (light is on) say where leaves move and lights pulse. Every image is the plate's size.\nProvenance is required, as for a face: a plate without it is not shown, and only a cleared one may ship.",
      "properties": {
        "darkroom": {
          "anyOf": [
            {
              "$ref": "#/$defs/DarkroomRender"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlateImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effects": {
          "$ref": "#/$defs/PlateEffects"
        },
        "kind": {
          "const": "plate",
          "default": "plate",
          "title": "Kind",
          "type": "string"
        },
        "light_mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlateImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mask_version": {
          "default": "1.5",
          "title": "Mask Version",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "plate": {
          "$ref": "#/$defs/PlateImage"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "sway_mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlateImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tint": {
          "default": "#ffffff",
          "description": "the scene's light, for the rim lights",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Tint",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "plate",
        "provenance"
      ],
      "title": "PlateManifest",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a face came from. Required: a face without it is not served.\n\n- ``personal``: the user's own use, anything they may lawfully use privately. Needs only ``source``; not\n  cleared to show or share.\n- ``stock``: a published asset under its licence. ``synthetic``: generated, with no real person or\n  owned character going in.\n- ``consented``: a real person's likeness (or an owned character) under a signed release, bound by the\n  release's sha256 (never the document) and the subject as the release names them.\n- ``curated``: refused until 0.3 defines what a curated face must prove.\n\nA ``synthetic`` (or ``personal``) face may say how it was generated (``generator``). A ``consented`` face is\nserved only with a valid consent record for its release (:mod:`argus_mask.consent`), and carries the\ndisclosure label.\n\nUnknown fields are refused, so a misspelt field cannot be dropped in silence; ``licence`` is accepted for\n``license``, and the derived ``cleared`` and ``disclosure`` a dumped record carries are recomputed, never read.",
      "properties": {
        "cleared": {
          "description": "Whether the face may be shown beyond the user's own screens: in a demo, a release, anything public.",
          "readOnly": true,
          "title": "Cleared",
          "type": "boolean"
        },
        "disclosure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The label shown with the face: set for a real person's likeness, which is never shown unlabelled.",
          "readOnly": true,
          "title": "Disclosure"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "personal",
            "stock",
            "synthetic",
            "consented",
            "curated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "default": "",
          "title": "License",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "release_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Sha256"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "subject": {
          "default": "",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "cleared",
        "disclosure"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RestSet": {
      "description": "A named baseline expression: what a face holds at rest and speaks from (``GET /face/{id}/rest``).\n\nThe viewer adds ``weights`` to every frame (the mouth's at half while speaking, so the mouth stays the\ndriver's) and, at rest, moves the face by ``life``: 0 still, 1 the default, up to 2.",
      "properties": {
        "life": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Life",
          "type": "number"
        },
        "name": {
