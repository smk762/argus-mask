{
  "$defs": {
    "AudioFormat": {
      "description": "How PCM bytes are laid out.",
      "properties": {
        "channels": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "format": {
          "default": "f32le",
          "enum": [
            "f32le",
            "s16le"
          ],
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate"
      ],
      "title": "AudioFormat",
      "type": "object"
    },
    "ConsentVerdict": {
      "additionalProperties": false,
      "description": "What a service returns about a record: the verdict and its reason, never the record itself.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "revoked",
                "not-yet-signed",
                "expired",
                "likeness-not-covered",
                "use-not-covered",
                "delivery-not-covered"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "ok"
      ],
      "title": "ConsentVerdict",
      "type": "object"
    },
    "DriverHealth": {
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "name",
        "available"
      ],
      "title": "DriverHealth",
      "type": "object"
    },
    "DriverInfo": {
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DriverInfo",
      "type": "object"
    },
    "FaceManifest": {
      "description": "``manifest.json`` in a face's directory.",
      "properties": {
        "blendshapes": {
          "items": {
            "type": "string"
          },
          "title": "Blendshapes",
          "type": "array"
        },
        "framing": {
          "$ref": "#/$defs/Framing"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "mask_version": {
          "default": "1.3",
          "title": "Mask Version",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelFile"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "name",
        "model",
        "provenance"
      ],
      "title": "FaceManifest",
      "type": "object"
    },
    "Frame": {
      "description": "One animation frame. ``t_ms`` is its time on the audio timeline.",
      "properties": {
        "head": {
          "$ref": "#/$defs/Head"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "type": {
          "const": "frame",
          "default": "frame",
          "title": "Type",
          "type": "string"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "title": "Weights",
          "type": "array"
        }
      },
      "required": [
        "seq",
        "t_ms",
        "weights"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Framing": {
      "description": "Where the viewer's camera sits for this head. Metres; the head's origin is the model's.",
      "properties": {
        "distance": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "title": "Distance",
          "type": "number"
        },
        "fov": {
          "default": 30.0,
          "exclusiveMaximum": 120,
          "exclusiveMinimum": 1,
          "title": "Fov",
          "type": "number"
        },
        "height": {
          "default": 0.0,
          "title": "Height",
          "type": "number"
        }
      },
      "title": "Framing",
      "type": "object"
    },
    "Generator": {
      "additionalProperties": false,
      "description": "How a generated face was made: the model (and its sha256), the seed and the prompt.",
      "properties": {
        "model": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Sha256"
        },
        "prompt": {
          "default": "",
          "maxLength": 4000,
          "title": "Prompt",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "model"
      ],
      "title": "Generator",
      "type": "object"
    },
    "Head": {
      "description": "Head rotation, in degrees.",
      "properties": {
        "pitch": {
          "default": 0.0,
          "title": "Pitch",
          "type": "number"
        },
        "roll": {
          "default": 0.0,
          "title": "Roll",
          "type": "number"
        },
        "yaw": {
          "default": 0.0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "title": "Head",
      "type": "object"
    },
    "Health": {
      "properties": {
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Stable names for faces: alias -> the face id it stands for now",
          "title": "Aliases",
          "type": "object"
        },
        "driver": {
          "$ref": "#/$defs/DriverHealth"
        },
        "faces": {
          "title": "Faces",
          "type": "integer"
        },
        "fps": {
          "title": "Fps",
          "type": "integer"
        },
        "free_vram_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Vram Mb"
        },
        "live": {
          "description": "Faces with a source connected",
          "items": {
            "type": "string"
          },
          "title": "Live",
          "type": "array"
        },
        "read_only": {
          "title": "Read Only",
          "type": "boolean"
        },
        "screens": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Screen"
            },
            "type": "array"
          },
          "description": "Per face (or alias, by the name the viewers used), the viewers that have reported their state",
          "title": "Screens",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "driver",
        "fps",
        "read_only",
        "faces"
      ],
      "title": "Health",
      "type": "object"
    },
    "ModelFile": {
      "description": "A face's model, in its directory: its file name, sha256 and format.\n\n- ``gltf``: a glTF 2.0 binary (``.glb``), morph targets named for the ARKit shapes. The default, so a\n  manifest from before 1.2 reads as it did.\n- ``lam-splat``: a LAM Gaussian-splat head (``.zip``): one folder holding ``skin.glb`` (the FLAME mesh and\n  its ARKit shapes), ``offset.ply`` (the splats), ``animation.glb``, ``vertex_order.json`` and optionally\n  ``iris_occlusion.json``.",
      "properties": {
        "file": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(glb|zip)$",
          "title": "File",
          "type": "string"
        },
        "format": {
          "default": "gltf",
          "description": "gltf: a .glb; lam-splat: a LAM Gaussian-splat head, a .zip",
          "enum": [
            "gltf",
            "lam-splat"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "title": "ModelFile",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a face came from. Required: a face without it is not served.\n\n- ``personal``: the user's own use, anything they may lawfully use privately. Needs only ``source``; not\n  cleared to show or share.\n- ``stock``: a published asset under its licence. ``synthetic``: generated, with no real person or\n  owned character going in.\n- ``consented``: a real person's likeness (or an owned character) under a signed release, bound by the\n  release's sha256 (never the document) and the subject as the release names them.\n- ``curated``: refused until 0.3 defines what a curated face must prove.\n\nA ``synthetic`` (or ``personal``) face may say how it was generated (``generator``). A ``consented`` face is\nserved only with a valid consent record for its release (:mod:`argus_mask.consent`), and carries the\ndisclosure label.\n\nUnknown fields are refused, so a misspelt field cannot be dropped in silence; ``licence`` is accepted for\n``license``, and the derived ``cleared`` and ``disclosure`` a dumped record carries are recomputed, never read.",
      "properties": {
        "cleared": {
          "description": "Whether the face may be shown beyond the user's own screens: in a demo, a release, anything public.",
          "readOnly": true,
          "title": "Cleared",
          "type": "boolean"
        },
        "disclosure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The label shown with the face: set for a real person's likeness, which is never shown unlabelled.",
          "readOnly": true,
          "title": "Disclosure"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "personal",
            "stock",
            "synthetic",
            "consented",
            "curated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "default": "",
          "title": "License",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "release_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Sha256"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "subject": {
          "default": "",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "cleared",
        "disclosure"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RestSet": {
      "description": "A named baseline expression: what a face holds at rest and speaks from (``GET /face/{id}/rest``).\n\nThe viewer adds ``weights`` to every frame (the mouth's at half while speaking, so the mouth stays the\ndriver's) and, at rest, moves the face by ``life``: 0 still, 1 the default, up to 2.",
      "properties": {
        "life": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Life",
          "type": "number"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "ARKit blendshape name -> weight, 0 to 1",
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "RestSet",
      "type": "object"
    },
    "Screen": {
      "description": "A viewer that has said what it is: one entry of ``Health.screens``.",
      "properties": {
        "audio_ready": {
          "description": "Ready to speak in sync: with sound local, its sound is unlocked (it will be heard); with sound external, it is watching and moves on the session's timeline, no sound of its own needed",
          "title": "Audio Ready",
          "type": "boolean"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "kiosk": {
          "default": false,
          "title": "Kiosk",
          "type": "boolean"
        },
        "sound": {
          "default": "local",
          "enum": [
            "local",
            "external"
          ],
          "title": "Sound",
          "type": "string"
        }
      },
      "required": [
        "display",
        "audio_ready"
      ],
      "title": "Screen",
      "type": "object"
    },
    "SourceHello": {
      "description": "The first message a source sends on its socket: its audio format, the idle layer's seed, and whether the\nvoice is a real, consenting person's (so the stream carries the disclosure label).",
      "properties": {
        "channels": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "disclose": {
          "default": false,
          "description": "the voice is a real person's, used with their consent",
          "title": "Disclose",
          "type": "boolean"
        },
        "format": {
          "default": "f32le",
          "enum": [
            "f32le",
            "s16le"
          ],
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate"
      ],
      "title": "SourceHello",
      "type": "object"
    },
    "StreamEnd": {
      "description": "Closes a stream: the source went away and every frame has been sent.",
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "frames": {
          "minimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "type": {
          "const": "end",
          "default": "end",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "frames",
        "duration_ms"
      ],
      "title": "StreamEnd",
      "type": "object"
    },
    "StreamHeader": {
      "description": "Opens a stream. ``blendshapes`` is the order of every frame's weights.",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioFormat"
        },
        "blendshapes": {
          "items": {
            "type": "string"
          },
          "title": "Blendshapes",
          "type": "array"
        },
        "disclosure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the label a viewer shows while this stream plays: set when the voice is a real person's",
          "title": "Disclosure"
        },
        "driver": {
          "$ref": "#/$defs/DriverInfo"
        },
        "face_id": {
          "title": "Face Id",
          "type": "string"
        },
        "fps": {
          "maximum": 120,
          "minimum": 1,
          "title": "Fps",
          "type": "integer"
        },
        "mask_version": {
          "default": "1.3",
          "title": "Mask Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "header",
          "default": "header",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "face_id",
        "session_id",
        "fps",
        "seed",
        "blendshapes",
        "audio",
        "driver"
      ],
      "title": "StreamHeader",
      "type": "object"
    },
    "ViewerStatus": {
      "description": "What a viewer says about itself on its socket, when it connects and whenever it changes.\n\nState, not media: whether it can play sound yet (a browser needs one click or key press first),\nand how it shows the face. The server keeps the latest per viewer and reports it on ``/health``.",
      "properties": {
        "audio": {
          "default": false,
          "description": "Sound is unlocked: the screen will be heard",
          "title": "Audio",
          "type": "boolean"
        },
        "display": {
          "default": "flat",
          "enum": [
            "flat",
            "hld",
            "go"
          ],
          "title": "Display",
          "type": "string"
        },
        "kiosk": {
          "default": false,
          "title": "Kiosk",
          "type": "boolean"
        },
        "sound": {
          "default": "local",
          "description": "local: the screen plays the session's sound; external: it plays none (house speakers, Snapcast, play it) and only moves, on the session's timeline (viewer ?audio=external)",
          "enum": [
            "local",
            "external"
          ],
          "title": "Sound",
          "type": "string"
        },
        "type": {
          "const": "status",
          "default": "status",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ViewerStatus",
      "type": "object"
    }
  },
  "title": "argus-mask wire contract"
}
