# NOTE: .git is deliberately *not* ignored -- hatch-vcs reads the version from
# git history at build time. So nothing tracked may be ignored here either: git
# would see it deleted and version the image as a dirty dev build (#88).
.venv
venv
dist
build
*.egg-info
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
