# Copy to .env and edit. Read by compose.yaml.

# Where the faces live: one directory per face, each a .glb and a manifest.json.
ASSETS_DIR=./assets

# energy: mouth from loudness, CPU only, crude. a2f: the Audio2Face server at A2F_URL.
DRIVER=energy
A2F_URL=

# With `docker compose --profile a2f`: DRIVER=a2f and A2F_URL=http://a2f:8110.
# Which character's Audio2Face model (james, mark or claire), and whether its solver runs on the GPU.
A2F_MODEL=james
A2F_GPU_SOLVER=0

# Animation frames per second. The viewer interpolates up to the screen's refresh rate.
FPS=30

# Host address the server is published on. 127.0.0.1 keeps it on this machine.
MASK_PUBLISH=127.0.0.1:8109

# Browser origins allowed to open the sockets, comma-separated. The server's own host is always
# allowed. Behind a TLS proxy, name the proxy's origin, e.g. https://mask.example.org
CORS_ORIGINS=

# 1 refuses every audio source; viewers still connect.
READ_ONLY=0

# The TTS stream endpoint for POST /speak (empty: /speak answers 422; /push needs none).
# From inside the container, a service on this host is http://host.docker.internal:<port>/...
# e.g. Miso TTS: http://host.docker.internal:8034/synthesise/stream, or wyoming://host:port
TTS_URL=
# The voice /speak asks for when the request names none: a stored clone's name, or a speaker number.
TTS_VOICE=

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
