# Copy to .env and edit. Read by compose.yaml.

# Where the faces live: one directory per face, each a .glb and a manifest.json.
ASSETS_DIR=./assets

# energy: mouth from loudness, CPU only, crude. a2f: the Audio2Face server at A2F_URL.
DRIVER=energy
A2F_URL=

# With `docker compose --profile a2f`: DRIVER=a2f and A2F_URL=http://a2f:8110.
# Which character's Audio2Face model (james, mark or claire), and whether its solver runs on the GPU.
A2F_MODEL=james
A2F_GPU_SOLVER=0

# Animation frames per second. The viewer interpolates up to the screen's refresh rate.
FPS=30

# Host address the server is published on. 127.0.0.1 keeps it on this machine.
MASK_PUBLISH=127.0.0.1:8109

# Browser origins allowed to open the sockets, comma-separated. Behind a TLS proxy, name the proxy's
# origin, e.g. https://mask.example.org
CORS_ORIGINS=
# Host names (no port) screens open the viewer at, comma-separated: a screen at http://<LAN_HOST>:8109
# needs <LAN_HOST> here, or its own server refuses its sockets. An IP address and localhost need no entry.
# A name is not trusted on its own: under DNS rebinding another site's page could use it.
TRUSTED_HOSTS=

# 1 refuses every audio source; viewers still connect.
READ_ONLY=0

# argus-darkroom: guided source generate/pick/restyle (#167) and `argus-mask plate`.
# ARGUS_MASK_DARKROOM_URL=http://localhost:8106
# ARGUS_MASK_DARKROOM_POLICY=default
# Guided portrait checks (#168): curator face_source + retina OCR. Unset → not_checked (blocks build).
# ARGUS_MASK_CURATOR_URL=http://localhost:8101
# ARGUS_MASK_OCR_URL=http://localhost:8133
# Guided turn checks (#170): playwright script; unset uses a checkout's lam/measure_turns.py when present.
# ARGUS_MASK_TURNS_SCRIPT=
# ARGUS_MASK_TURNS_GAP=0.18
# Guided speech eval (#171): fixed talk.json take + MediaPipe lip gap vs splat-01.
# ARGUS_MASK_SPEECH_SCRIPT=
# ARGUS_MASK_SPEECH_TAKE=
# ARGUS_MASK_SPEECH_REFERENCE=splat-01
# Guided age read (#172): curator POST /faces; flag when head − portrait ≥ this many years.
# ARGUS_MASK_AGE_OLDER_YEARS=7


# The TTS stream endpoint for POST /speak (empty: /speak answers 422; /push needs none).
# From inside the container, a service on this host is http://host.docker.internal:<port>/...
# e.g. Miso TTS: http://host.docker.internal:8034/synthesise/stream, or wyoming://host:port
TTS_URL=
# The voice /speak asks for when the request names none: a stored clone's name, or a speaker number.
TTS_VOICE=

# ── argus-iris GPU broker ──
# Mask's own process uses no GPU; it leases for the GPU work it asks of others (gpu-tenant.yaml):
# Audio2Face while a face speaks (realtime, asked of the broker alone, never waited on), and a TTS
# service making a voice (interactive). The URL and token below are all it takes: mask registers
# gpu-tenant.yaml (in the image) with iris at startup. Without a URL it takes no leases.
# Where iris listens, by IP (e.g. http://<GPU_BROKER_HOST>:8120): a2f holds :8110.
ARGUS_GPU_BROKER_URL=
# The suite's shared caller token (Authorization: Bearer). Secret: host .env only.
ARGUS_GPU_BROKER_TOKEN=
# Only to override the broker URL: none | lease (voice making takes the host-wide lock; no a2f lease).
ARGUS_GPU_COORDINATOR=
# When iris can't be reached, voice making uses: lease (the host-wide lock) | none.
# A live Audio2Face stream never falls back.
ARGUS_GPU_BROKER_FALLBACK=lease

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
