# Copy to .env and edit. Read by compose.yaml.

# Where the faces live: one directory per face, each a .glb and a manifest.json.
ASSETS_DIR=./assets

# energy: mouth from loudness, CPU only, crude. a2f: the Audio2Face server at A2F_URL.
DRIVER=energy
A2F_URL=

# Animation frames per second. The viewer interpolates up to the screen's refresh rate.
FPS=30

# Host address the server is published on. 127.0.0.1 keeps it on this machine.
MASK_PUBLISH=127.0.0.1:8109

# Browser origins allowed to open the sockets, comma-separated. The server's own host is always
# allowed. Behind a TLS proxy, name the proxy's origin, e.g. https://mask.example.org
CORS_ORIGINS=

# 1 refuses every audio source; viewers still connect.
READ_ONLY=0
